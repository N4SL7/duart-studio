# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a GitHub.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos: si no se define, se usa SQLite (desarrollo).
# Producción (PostgreSQL en Neon):
# DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# Contenedor
CARGAR_DATOS_DEMO=True
DJANGO_ADMIN_PASSWORD=cambia-esta-clave

# --- Entrega 3: microservicio Node.js ---
# Secretos compartidos entre Django y Node (deben ser iguales en los dos servicios)
SERVICIO_API_KEY=cambia-esta-clave-de-servicio
WEBHOOK_SECRET=cambia-este-secreto-de-webhook

# Django -> Node: dirección de Node vista desde Django (webhook) y desde el navegador (chat)
NODE_SERVICE_URL=http://127.0.0.1:3000
NODE_PUBLIC_URL=http://127.0.0.1:3000

# Node -> Django
DJANGO_API_URL=http://127.0.0.1:8000
SITIO_PUBLICO_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# IA generativa. Sin clave, el asistente responde solo con preguntas frecuentes y WhatsApp.
# Google Gemini (gratis): crea la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternativa: Claude (Anthropic), de pago
ANTHROPIC_API_KEY=
# Opcional: forzar proveedor (gemini | anthropic) o modelo (por defecto gemini-3.5-flash-lite / claude-opus-5-5)
LLM_PROVIDER=
LLM_MODEL=

# WhatsApp del taller (formato internacional, sin "+")
WHATSAPP_NUMERO=573000000000
