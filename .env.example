# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a GitHub.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos: si no se define, se usa SQLite (desarrollo).
# Producción (PostgreSQL en Neon):
# DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# Contenedor
CARGAR_DATOS_DEMO=True
DJANGO_ADMIN_PASSWORD=cambia-esta-clave

# API de IA (LLM) – a partir de la Entrega 3
