skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #16171B
skinparam ArrowFontSize 11
skinparam usecase {
  BackgroundColor #FFE3CC
  BorderColor #FF6B00
}
skinparam actorBorderColor #16171B
skinparam rectangle {
  BorderColor #16171B
  BackgroundColor white
}
skinparam component {
  BackgroundColor #FFF1E6
  BorderColor #FF6B00
}
skinparam node {
  BackgroundColor #F5F5F5
  BorderColor #2A2B30
}
skinparam database {
  BackgroundColor #FFE3CC
  BorderColor #FF6B00
}
skinparam artifact {
  BackgroundColor white
  BorderColor #FF6B00
}
skinparam interface {
  BackgroundColor white
  BorderColor #16171B
}
